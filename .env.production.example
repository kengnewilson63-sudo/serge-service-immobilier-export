# =============================================================================
#  Configuration de MISE EN LIGNE (production)
#  À copier en `.env` à la racine du projet :
#      cp .env.production.example .env
#  puis remplacer chaque « REMPLACER_... » par une vraie valeur.
#  Ne JAMAIS envoyer ce fichier .env sur GitHub (déjà ignoré par git).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. URL du site (OBLIGATOIRE — remplacez par votre vrai domaine)
# -----------------------------------------------------------------------------
# Utilisé pour : sitemap, liens e-mail, canonical, partage Facebook/WhatsApp.
APP_PUBLIC_URL=https://REMPlacer-par-votre-domaine.cm
VITE_SITE_URL=https://REMPlacer-par-votre-domaine.cm
# IMPORTANT : laisser VIDE. Le site et l'API partagent la même adresse.
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 2. Sécurité (OBLIGATOIRE — valeurs uniques et fortes)
# -----------------------------------------------------------------------------
# Générer avec :  openssl rand -base64 48
JWT_SECRET=REMPLACER_CHAINE_ALEATOIRE_48_CARACTERES
# Compte administrateur créé au tout premier démarrage.
ADMIN_EMAIL=admin@serge-immobilier.com
# 10 caractères minimum, avec majuscule, chiffre et symbole.
ADMIN_PASSWORD=REMPLACER_MOT_DE_PASSE_FORT

# Accès de secours à /admin : sur /login → « J'ai un code d'accès »,
# e-mail admin + ce code. Utile si le mot de passe est oublié.
# Laissez vide pour désactiver complètement ce mode.
SETUP_CODE=REMPLACER_CODE_SECOURS

# Inscription publique : garder false. Seul l'admin crée les comptes.
ALLOW_REGISTRATION=false

# -----------------------------------------------------------------------------
# 3. Base de données (OBLIGATOIRE)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=REMPLACER_MOT_DE_PASSE_POSTGRES_FORT

# -----------------------------------------------------------------------------
# 4. Port du site sur le serveur (facultatif)
# -----------------------------------------------------------------------------
# Le site écoute sur http://<serveur>:5170. Caddy/nginx doit pointer ici.
APP_PORT=5170

# -----------------------------------------------------------------------------
# 5. E-mails de réinitialisation de mot de passe (RECOMMANDÉ)
# -----------------------------------------------------------------------------
# Sans SMTP : la page « mot de passe oublié » n'envoie rien (le lien n'est pas
# affiché en production). Le mot de passe reste modifiable depuis /admin.
# Gmail : créer un « mot de passe d'application » (pas le mot de passe du compte).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REMPLACER_votre-adresse@gmail.com
SMTP_PASSWORD=REMPLACER_mot-de-passe-application
MAIL_FROM=no-reply@sergeserviceimmo.cm
# Ne jamais passer à true en production : le lien de réinitialisation
# s'afficherait à l'écran de n'importe quel visiteur.
MAIL_EXPOSE_RESET_LINK=false

# -----------------------------------------------------------------------------
# 6. Référencement (facultatif)
# -----------------------------------------------------------------------------
# Valeur de la balise HTML fournie par Google Search Console.
GOOGLE_SITE_VERIFICATION=
