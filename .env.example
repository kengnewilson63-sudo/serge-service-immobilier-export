# Exemple de configuration locale.
#   • Développement : copiez ce fichier en `.env.local` (frontend) et en `backend/.env`.
#   • Production : copiez-le en `.env` à la racine (utilisé par docker-compose.prod.yml).

# --- Frontend (Vite) : URL du backend Spring Boot ---
# En développement : http://localhost:8080.
# En production (site servi par le même serveur) : laissez VIDE.
VITE_API_BASE_URL=http://localhost:8080
# URL publique du site (canonical, sitemap, partage social).
VITE_SITE_URL=http://localhost:5173
VITE_BASE44_APP_ID=6abf782998bb3e8f408ffb22

# --- Base PostgreSQL ---
# Port 5433 par défaut du docker-compose (évite un PostgreSQL déjà installé sur 5432).
DB_URL=jdbc:postgresql://localhost:5433/serge_immobilier
DB_USERNAME=serge
DB_PASSWORD=serge123
POSTGRES_PASSWORD=serge123

# --- Sécurité ---
# Chaîne aléatoire longue, ex. : openssl rand -base64 48
JWT_SECRET=remplacez-par-une-chaine-aleatoire-longue
# Le compte admin est créé au premier démarrage avec ces valeurs.
ADMIN_EMAIL=admin@serge-immobilier.com
ADMIN_PASSWORD=changez-ce-mot-de-passe
# Accès de secours à /admin : sur /login, "J'ai un code d'accès" + e-mail admin + ce code.
# Laissez vide pour désactiver.
SETUP_CODE=
# --- Référencement (Google Search Console) ---
# Valeur de la balise HTML fournie par Search Console (facultatif).
GOOGLE_SITE_VERIFICATION=

# --- URL publique (liens d'e-mail, sitemap) ---
# Développement : http://localhost:5173 — Production : https://votre-domaine.cm
APP_PUBLIC_URL=http://localhost:5173

# --- Photos ---
UPLOAD_DIR=./uploads

# --- Envoi d'e-mails (réinitialisation de mot de passe) ---
# Si vide : aucun e-mail envoyé. Le lien est affiché dans l'interface uniquement
# si MAIL_EXPOSE_RESET_LINK=true (jamais en production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sergeserviceimmo.cm
MAIL_EXPOSE_RESET_LINK=true
